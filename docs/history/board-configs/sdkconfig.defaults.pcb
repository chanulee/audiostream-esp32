# LOVELACE / AS-001: protected power, PCM5102A BCK PLL, GPIO21 green status LED.
CONFIG_I2S_BCK_IO=11
CONFIG_I2S_DO_IO=12
CONFIG_I2S_WS_IO=13
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1
CONFIG_LED_RGB_GPIO=-1
CONFIG_LED_STATUS_GPIO=21
CONFIG_LED_ERROR_GPIO=-1
CONFIG_BAT_CHANNEL=-1

# GPIO sources current through R18 into the LED anode.
# CONFIG_LED_STATUS_INVERT is not set
CONFIG_LED_STATUS_BRIGHTNESS=128
CONFIG_LED_STATUS_PLAYING_STEADY=y
CONFIG_LED_STATUS_PAUSED_BLINK_MEDIUM=y
CONFIG_LED_STATUS_STANDBY_BLINK_SLOW=y
