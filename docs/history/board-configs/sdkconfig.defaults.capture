# S3 N16R8, no external DAC or display required.
CONFIG_AUDIO_CAPTURE_ENABLED=y
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1
CONFIG_OUTPUT_SAMPLE_RATE_44100=y
# CONFIG_BT_A2DP_ENABLE is not set

CONFIG_SPOTIFY_ENABLED=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_LWIP_MAX_SOCKETS=24
