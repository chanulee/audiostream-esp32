# LOVELACE / AS-003, AS-004 (same netlist) — ESP32-WROVER-E-N8R8, PCM5102A (also the board pins below)
CONFIG_BOARD_ESP32_GENERIC=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_OUTPUT_SAMPLE_RATE_44100=y
CONFIG_SPOTIFY_ENABLED=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_LWIP_MAX_SOCKETS=24
# AS-003 / AS-004 pins: BCK / DIN / LRCK leave the module in the DAC's pin order.
CONFIG_I2S_BCK_IO=21
CONFIG_I2S_WS_IO=18
CONFIG_I2S_DO_IO=19
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1
CONFIG_LED_STATUS_GPIO=23
# PCM5102A XSMT (soft mute, low = muted) on GPIO22; 10k pull-down keeps the
# DAC muted through reset and boot. audio_output.c unmutes once I2S runs.
CONFIG_MUTE_GPIO=22
CONFIG_MUTE_GPIO_LEVEL=0
CONFIG_LED_RGB_GPIO=-1
CONFIG_LED_ERROR_GPIO=-1
# One button on GPIO0 (also the ROM download strap): press = play/pause,
# double = next, hold 3 s = Bluetooth pairing.
CONFIG_BTN_PLAY_PAUSE_GPIO=0
CONFIG_BTN_PLAY_PAUSE_DOUBLE_CLICK=y
CONFIG_BTN_SINGLE_BUTTON_UI=y
# CONFIG_AUDIO_CAPTURE_ENABLED is not set
# CONFIG_LED_STATUS_INVERT is not set
CONFIG_LED_STATUS_BRIGHTNESS=128
CONFIG_LED_STATUS_PLAYING_STEADY=y
CONFIG_LED_STATUS_PAUSED_BLINK_MEDIUM=y
CONFIG_LED_STATUS_STANDBY_BLINK_SLOW=y
# Headless Secure Simple Pairing (Just Works); legacy devices can use 0000.
CONFIG_BT_SSP_ENABLED=y
CONFIG_BT_PIN_CODE="0000"

CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32_REV_MIN_3=y
CONFIG_DEFAULT_AP_SSID="LOVELACE-Setup"
